# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Supabase (new API key system) ---
NEXT_PUBLIC_SUPABASE_URL=
# Settings -> API Keys -> Secret keys -> "default" -> the sb_secret_... value (not the
# sb_publishable_... one). Server-only, full privileged access — this app has no client-side
# publishable-key usage by design (see the RLS note in supabase/schema.sql).
SUPABASE_SECRET_KEY=

# --- Google (shared OAuth client + access@hueston.co refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=

# --- Cron / internal auth ---
CRON_SECRET=
